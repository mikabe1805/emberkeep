rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validBuildTitle(title) {
      return title.matches(
        '^(STRONG |MIGHTY |TITAN |VITAL |RADIANT |UNDIMMED |ASTUTE |SAGE |LUMINARY |SKILLED |EXPERT |MASTER |BELOVED |MAGNETIC |BEACON |HOMEY |WELCOMING |SANCTUARY )?(BLANK SLATE|LIONHEART|WARRIOR SCHOLAR|SILENT HAMMER|GENTLE GIANT|HOMESTEADER|CLEAR SPRING|STEADY HAND|STEADY FLAME|SUNSHINE SOUL|EVERGREEN|DEEP CURRENT|STORYTELLER|QUIET MASTER|PRESENT HEART|UNSHAKEABLE|OPEN HOUSE|OPEN HEARTH|BRAWLER|WELLSPRING|SCHOLAR|MAKER|FRIEND|KEEPER)$'
      );
    }

    function validPresence(d) {
      return d.keys().hasAll([
          'memories', 'weather', 'todayLit', 'focusKind', 'focusUntil'
        ])
        && d.memories is int && d.memories >= 0 && d.memories <= 9999
        && d.weather in ['unknown', 'low', 'steady', 'bright']
        && d.todayLit is bool
        && d.focusKind in ['none', 'study', 'making', 'reset', 'quiet']
        && d.focusUntil is int
        && d.focusUntil >= 0 && d.focusUntil <= 9999999999999;
    }

    function validSharedProfile(d) {
      return d.keys().hasAll([
          'profileVisible', 'displayName', 'about', 'featuredGoals'
        ])
        && d.profileVisible is bool
        && d.displayName is string && d.displayName.size() <= 40
        && d.about is string && d.about.size() <= 180
        && d.featuredGoals is list && d.featuredGoals.size() <= 3
        && (d.featuredGoals.size() < 1
          || (d.featuredGoals[0] is string && d.featuredGoals[0].size() <= 100))
        && (d.featuredGoals.size() < 2
          || (d.featuredGoals[1] is string && d.featuredGoals[1].size() <= 100))
        && (d.featuredGoals.size() < 3
          || (d.featuredGoals[2] is string && d.featuredGoals[2].size() <= 100))
        && (d.profileVisible
          || (d.displayName == '' && d.about == '' && d.featuredGoals.size() == 0));
    }

    function validPinnedMoment(moment) {
      return moment is map
        && moment.keys().hasOnly(['text', 'at'])
        && moment.text is string && moment.text.size() > 0
        && moment.text.size() <= 240
        && moment.at is int && moment.at >= 0 && moment.at <= 9999999999999;
    }

    function validSharedCards(d) {
      return d.keys().hasAll(['cardOrder', 'pinnedMoments', 'season'])
        && d.cardOrder is list && d.cardOrder.size() <= 4
        && d.cardOrder.hasOnly([
          'about', 'rightNow', 'pinnedMoments', 'thisSeason'
        ])
        && d.pinnedMoments is list && d.pinnedMoments.size() <= 4
        && (d.pinnedMoments.size() < 1 || validPinnedMoment(d.pinnedMoments[0]))
        && (d.pinnedMoments.size() < 2 || validPinnedMoment(d.pinnedMoments[1]))
        && (d.pinnedMoments.size() < 3 || validPinnedMoment(d.pinnedMoments[2]))
        && (d.pinnedMoments.size() < 4 || validPinnedMoment(d.pinnedMoments[3]))
        && d.season is string && d.season.size() <= 180
        && (d.cardOrder.hasAny(['about']) || d.about == '')
        && (d.cardOrder.hasAny(['rightNow']) || d.featuredGoals.size() == 0)
        && (d.cardOrder.hasAny(['pinnedMoments']) || d.pinnedMoments.size() == 0)
        && (d.cardOrder.hasAny(['thisSeason']) || d.season == '')
        && (d.profileVisible
          || (d.cardOrder.size() == 0
            && d.pinnedMoments.size() == 0
            && d.season == ''));
    }

    function validSharedPhotoPath(path, ownerKey, code, slot) {
      let parts = path.split('/');
      return path == ''
        // Legacy pre-release objects remain valid until their next edit.
        || path == 'shared_rooms/' + ownerKey + '/' + code + '/' + slot
        || (parts.size() == 5
          && parts[0] == 'shared_rooms'
          && parts[1] == ownerKey
          && parts[2] == code
          && parts[3] == slot
          && parts[4].matches('^[A-Za-z0-9_-]{22}$'));
    }

    function validSharedPhotos(d, code) {
      return d.keys().hasAll(['profilePhotoPath', 'seasonPhotoPath'])
        && d.profilePhotoPath is string && d.profilePhotoPath.size() <= 192
        && d.seasonPhotoPath is string && d.seasonPhotoPath.size() <= 192
        && validSharedPhotoPath(d.profilePhotoPath, d.ownerKey, code, 'profile')
        && validSharedPhotoPath(d.seasonPhotoPath, d.ownerKey, code, 'season')
        && (d.profileVisible
          || (d.profilePhotoPath == '' && d.seasonPhotoPath == ''))
        && (d.cardOrder.hasAny(['thisSeason']) || d.seasonPhotoPath == '');
    }

    function validRoom(code) {
      let d = request.resource.data;
      return code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && d.keys().hasOnly([
          'ownerKey', 'name', 'title', 'level', 'furniture', 'wall', 'floor',
          'skin', 'window', 'awake', 'memories', 'weather', 'todayLit',
          'focusKind', 'focusUntil', 'profileVisible', 'displayName', 'about',
          'featuredGoals', 'cardOrder', 'pinnedMoments', 'season', 'v',
          'profilePhotoPath', 'seasonPhotoPath',
          'updatedAt'
        ])
        && d.ownerKey == ownerKeyFor(request.auth.uid)
        && d.name == 'Fellow keeper'
        && d.title is string && validBuildTitle(d.title)
        && d.level is int && d.level >= 1 && d.level <= 9999
        && d.furniture is list && d.furniture.size() <= 12
        && d.furniture.hasOnly([
          'rug', 'cushion', 'plant', 'candles', 'lamp', 'garland', 'shelf',
          'picture', 'chair', 'pet', 'hearth'
        ])
        && d.wall in [
          'wall_conservatory', 'wall_archive',
          'wall_walnut', 'wall_plum', 'wall_sage', 'wall_clay', 'wall_amber',
          'wall_indigo', 'wall_berry'
        ]
        && d.floor in [
          'floor_oak', 'floor_ash', 'floor_walnut', 'floor_terra',
          'floor_maple', 'floor_cherry'
        ]
        && d.skin in [
          'ember_amber', 'rose_quartz', 'mint_glass', 'periwinkle', 'lilac',
          'sunstone', 'sea_glass', 'moon_pearl', 'slate', 'gilded',
          'found_ember', 'found_moss', 'found_bloom', 'found_honey',
          'found_candle', 'found_aurora', 'found_midnight',
          'found_periwinkle', 'found_plum', 'found_storm', 'found_rosewood',
          'found_founder', 'found_weeklong', 'found_eternal',
          'found_spotless', 'found_renaissance', 'found_marathoner'
        ]
        && d.window in ['moon', 'city', 'forest', 'mountains', 'rain', 'dawn', 'aurora']
        && d.awake is bool
        && (
          (d.v == 1 && !d.keys().hasAny([
            'memories', 'weather', 'todayLit', 'focusKind', 'focusUntil',
            'profileVisible', 'displayName', 'about', 'featuredGoals',
            'cardOrder', 'pinnedMoments', 'season',
            'profilePhotoPath', 'seasonPhotoPath'
          ]))
          ||
          (d.v == 2
            && validPresence(d)
            && !d.keys().hasAny([
              'profileVisible', 'displayName', 'about', 'featuredGoals',
              'cardOrder', 'pinnedMoments', 'season',
              'profilePhotoPath', 'seasonPhotoPath'
            ])
          )
          ||
          (d.v == 3
            && validPresence(d)
            && validSharedProfile(d)
            && !d.keys().hasAny([
              'cardOrder', 'pinnedMoments', 'season',
              'profilePhotoPath', 'seasonPhotoPath'
            ])
          )
          ||
          (d.v == 4
            && validPresence(d)
            && validSharedProfile(d)
            && validSharedCards(d)
            && !d.keys().hasAny(['profilePhotoPath', 'seasonPhotoPath'])
          )
          ||
          (d.v == 6
            && validPresence(d)
            && validSharedProfile(d)
            && validSharedCards(d)
            && validSharedPhotos(d, code)
            // The bearer room remains generated-only. Moderated, bounded
            // authored cards live in the separate audience projections below.
            && d.profileVisible == false
          )
        )
        && d.updatedAt == request.time;
    }

    function serviceIdentityDeletionStarted(uid) {
      return exists(
        /databases/$(database)/documents/serviceIdentityDeletionTombstones/$(uid)
      );
    }

    // Discoverability is a deliberately separate, minimal projection.
    // It must never become a list query over /rooms: room codes remain bearer
    // keys and the room document contains more context than a directory needs.
    // The optional public name is the only authored field. Clients may create
    // it only blank and must preserve it on refresh; only the moderated Admin
    // callable may change it. ownerKey is a stable, non-reversible SHA-256
    // projection of the room owner's UID, used for bans without exposing UID.
    function ownerKeyFor(uid) {
      // Rules hashing consumes UTF-8 bytes; this is the Rules-valid form of
      // the SHA-256(uid) contract.
      return hashing.sha256(uid.toUtf8()).toHexString().lower();
    }

    function ownerIsNotBanned(ownerKey) {
      return !exists(
        /databases/$(database)/documents/discoveryBans/$(ownerKey)
      );
    }

    function validDiscoverableSpaceShape(code, d) {
      return code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && d.keys().hasOnly([
          'v', 'title', 'level', 'wall', 'floor', 'skin', 'window', 'bucket',
          'publicName', 'ownerKey', 'updatedAt', 'expiresAt'
        ])
        && d.v == 3
        && d.title is string && validBuildTitle(d.title)
        && d.level is int && d.level >= 1 && d.level <= 9999
        && d.wall in [
          'wall_conservatory', 'wall_archive',
          'wall_walnut', 'wall_plum', 'wall_sage', 'wall_clay', 'wall_amber',
          'wall_indigo', 'wall_berry'
        ]
        && d.floor in [
          'floor_oak', 'floor_ash', 'floor_walnut', 'floor_terra',
          'floor_maple', 'floor_cherry'
        ]
        && d.skin in [
          'ember_amber', 'rose_quartz', 'mint_glass', 'periwinkle', 'lilac',
          'sunstone', 'sea_glass', 'moon_pearl', 'slate', 'gilded',
          'found_ember', 'found_moss', 'found_bloom', 'found_honey',
          'found_candle', 'found_aurora', 'found_midnight',
          'found_periwinkle', 'found_plum', 'found_storm', 'found_rosewood',
          'found_founder', 'found_weeklong', 'found_eternal',
          'found_spotless', 'found_renaissance', 'found_marathoner'
        ]
        && d.window in [
          'moon', 'city', 'forest', 'mountains', 'rain', 'dawn', 'aurora'
        ]
        && d.bucket is int && d.bucket >= 0 && d.bucket <= 999999
        && d.publicName is string && d.publicName.size() <= 32
        && d.ownerKey is string && d.ownerKey.matches('^[a-f0-9]{64}$')
        && d.updatedAt is timestamp
        && d.expiresAt is timestamp;
    }

    function validDiscoverableSpaceData(code, d) {
      return validDiscoverableSpaceShape(code, d)
        && d.expiresAt > request.time;
    }

    function validDiscoverableSpace(code) {
      return validDiscoverableSpaceData(code, request.resource.data)
        && request.resource.data.ownerKey == ownerKeyFor(request.auth.uid)
        && discoverableSpaceHasLiveAnchor(code, request.resource.data)
        && ownerIsNotBanned(request.resource.data.ownerKey)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt
          <= request.time + duration.value(31, 'd');
    }

    function ownsRoom(code) {
      return request.auth != null
        && exists(/databases/$(database)/documents/rooms/$(code))
        && exists(/databases/$(database)/documents/roomOwners/$(code))
        && get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
          == request.auth.uid;
    }

    // Build 31 stored ownership only inside its v5 room. Let that exact owner
    // read it and replace it once with v6 plus the private registry in the same
    // atomic batch. Visitors never receive the legacy document or raw uid.
    function migratesOwnedLegacyRoom(code) {
      return request.auth != null
        && resource.data.v == 5
        && resource.data.uid == request.auth.uid;
    }

    // A directory record is readable only while both public room projections
    // still point at the same opaque owner generation. This makes a stale
    // record immediately disappear from Discover when a short code is reused
    // by another account, even before the deletion trigger runs.
    function discoverableSpaceHasLiveAnchor(code, d) {
      return exists(/databases/$(database)/documents/rooms/$(code))
        && get(/databases/$(database)/documents/rooms/$(code)).data.v == 6
        && get(/databases/$(database)/documents/rooms/$(code)).data.profileVisible == false
        && get(/databases/$(database)/documents/rooms/$(code)).data.ownerKey == d.ownerKey
        && exists(/databases/$(database)/documents/roomOwners/$(code))
        && get(/databases/$(database)/documents/roomOwners/$(code)).data.ownerKey == d.ownerKey;
    }

    function normalRoomRemovalAllowed(code) {
      return !serviceIdentityDeletionStarted(request.auth.uid)
        && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code));
    }

    function fencedRoomRemovalAllowed(code) {
      return get(/databases/$(database)/documents/roomDeletionLocks/$(code)).data.uid
          == request.auth.uid
        && !existsAfter(
          /databases/$(database)/documents/roomDeletionLocks/$(code)
        );
    }

    // Authenticated Functions write these two projections. They deliberately
    // sit outside /rooms: Firestore grants a document read as a whole and
    // therefore cannot safely redact Mutuals-only cards from a public room.
    function validSpaceProfile(d) {
      return d.keys().hasOnly([
          'v', 'ownerKey', 'displayName', 'cardOrder', 'about',
          'featuredGoals', 'pinnedMoments', 'season', 'roomUpdatedAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'v', 'ownerKey', 'displayName', 'cardOrder', 'about',
          'featuredGoals', 'pinnedMoments', 'season', 'roomUpdatedAt', 'updatedAt'
        ])
        && d.v == 2
        && d.ownerKey is string && d.ownerKey.matches('^[a-f0-9]{64}$')
        && d.displayName is string && d.displayName.size() <= 40
        && d.cardOrder is list && d.cardOrder.size() <= 4
        && d.cardOrder.hasOnly(['about', 'rightNow', 'pinnedMoments', 'thisSeason'])
        && d.cardOrder.toSet().size() == d.cardOrder.size()
        && (d.cardOrder.size() > 0 || d.displayName == '')
        && d.about is string && d.about.size() <= 180
        && d.featuredGoals is list && d.featuredGoals.size() <= 3
        && (d.featuredGoals.size() < 1
          || (d.featuredGoals[0] is string && d.featuredGoals[0].size() <= 100))
        && (d.featuredGoals.size() < 2
          || (d.featuredGoals[1] is string && d.featuredGoals[1].size() <= 100))
        && (d.featuredGoals.size() < 3
          || (d.featuredGoals[2] is string && d.featuredGoals[2].size() <= 100))
        && d.pinnedMoments is list && d.pinnedMoments.size() <= 4
        && (d.pinnedMoments.size() < 1 || validPinnedMoment(d.pinnedMoments[0]))
        && (d.pinnedMoments.size() < 2 || validPinnedMoment(d.pinnedMoments[1]))
        && (d.pinnedMoments.size() < 3 || validPinnedMoment(d.pinnedMoments[2]))
        && (d.pinnedMoments.size() < 4 || validPinnedMoment(d.pinnedMoments[3]))
        && d.season is string && d.season.size() <= 180
        && (d.cardOrder.hasAny(['about']) || d.about == '')
        && (d.cardOrder.hasAny(['rightNow']) || d.featuredGoals.size() == 0)
        && (d.cardOrder.hasAny(['pinnedMoments']) || d.pinnedMoments.size() == 0)
        && (d.cardOrder.hasAny(['thisSeason']) || d.season == '')
        && d.roomUpdatedAt is timestamp
        && d.updatedAt is timestamp;
    }

    function profileMatchesLiveRoom(code, d) {
      return exists(/databases/$(database)/documents/rooms/$(code))
        && get(/databases/$(database)/documents/rooms/$(code)).data.v == 6
        && get(/databases/$(database)/documents/rooms/$(code)).data.profileVisible == false
        && get(/databases/$(database)/documents/rooms/$(code)).data.ownerKey == d.ownerKey
        && get(/databases/$(database)/documents/rooms/$(code)).data.updatedAt == d.roomUpdatedAt
        && exists(/databases/$(database)/documents/roomOwners/$(code))
        && get(/databases/$(database)/documents/roomOwners/$(code)).data.ownerKey == d.ownerKey;
    }

    function reciprocalCircle(ownerKey) {
      return request.auth != null
        && ownerKey != ownerKeyFor(request.auth.uid)
        && exists(/databases/$(database)/documents/circleRelationships/$(ownerKeyFor(request.auth.uid))/outgoing/$(ownerKey))
        && exists(/databases/$(database)/documents/circleRelationships/$(ownerKey)/outgoing/$(ownerKeyFor(request.auth.uid)))
        && !exists(/databases/$(database)/documents/spaceBlocks/$(ownerKeyFor(request.auth.uid))/blocked/$(ownerKey))
        && !exists(/databases/$(database)/documents/spaceBlocks/$(ownerKey)/blocked/$(ownerKeyFor(request.auth.uid)));
    }

    // Each anonymous user may touch exactly one document: their own save.
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && !serviceIdentityDeletionStarted(uid);
    }
    // Shared "spaces" (round-52, social): a public, read-only-to-others room
    // card keyed by a short bearer code. The current service accepts only v6
    // generated appearance/presence documents with every user-authored profile
    // and photo field empty. Older schema validation remains solely to document
    // migrations; it is not accepted at the write boundary. Only the owner may
    // create, replace, or delete a room document.
    match /rooms/{code} {
      // A code is the bearer key. Single-room reads work without forcing a
      // visitor to enable cloud backup. The only list shape is a bounded query
      // for the signed-in owner's own uid, used to prove anonymous deletion.
      // Legacy pre-release profile documents remain stored for their owners,
      // but code bearers cannot read them. Only the generated-only v6 shape is
      // visitor-readable; authored cards use audience-specific documents.
      allow get: if (
                   resource.data.v == 6
                   && resource.data.profileVisible == false
                 ) || (
                   request.auth != null
                   && resource.data.v == 5
                   && resource.data.uid == request.auth.uid
                 );
      allow list: if false;
      allow create: if request.auth != null
                    && !serviceIdentityDeletionStarted(request.auth.uid)
                    && request.resource.data.v == 6
                    && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                    && getAfter(/databases/$(database)/documents/roomOwners/$(code)).data.uid == request.auth.uid
                    && validRoom(code);
      allow update: if request.auth != null
                    && (migratesOwnedLegacyRoom(code) || ownsRoom(code))
                    && !serviceIdentityDeletionStarted(request.auth.uid)
                    && request.resource.data.v == 6
                    && request.resource.data.v >= resource.data.v
                    && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                    && validRoom(code);
      allow delete: if request.auth != null
                    && ownsRoom(code)
                    && (
                      (
                        !serviceIdentityDeletionStarted(request.auth.uid)
                        && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      )
                      || (
                        get(/databases/$(database)/documents/roomDeletionLocks/$(code)).data.uid
                          == request.auth.uid
                        && !existsAfter(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      )
                    );

      // Text-free encouragement only. A sender has one pending document,
      // keyed by their uid; only the room owner can see or collect it. There
      // is no chat body, task data, profile body, or public sender list.
      match /sparks/{senderId} {
        // Mirrors circleAdds: you cannot spark your own room, so the support
        // inbox can never be self-inflated through the raw API.
        allow create: if request.auth != null
                      && senderId == request.auth.uid
                      && !serviceIdentityDeletionStarted(request.auth.uid)
                      && exists(/databases/$(database)/documents/rooms/$(code))
                      && !serviceIdentityDeletionStarted(
                        get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                      )
                      && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      && get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                         != request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'sender', 'kind', 'sentAt'
                      ])
                      && request.resource.data.sender == request.auth.uid
                      && request.resource.data.kind in [
                        'kindle', 'steady', 'cheer'
                      ]
                      && request.resource.data.sentAt == request.time;
        allow read, delete: if request.auth != null
                            && get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                               == request.auth.uid;
        allow update: if false;
      }

      // A generic, text-free receipt when somebody saves this room to Circle.
      // It is private to the room owner and deliberately carries no profile.
      match /circleAdds/{senderId} {
        allow create: if request.auth != null
                      && senderId == request.auth.uid
                      && !serviceIdentityDeletionStarted(request.auth.uid)
                      && exists(/databases/$(database)/documents/rooms/$(code))
                      && !serviceIdentityDeletionStarted(
                        get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                      )
                      && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      && get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                         != request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'sender', 'kind', 'sentAt'
                      ])
                      && request.resource.data.sender == request.auth.uid
                      && request.resource.data.kind == 'circle_added'
                      && request.resource.data.sentAt == request.time;
        allow read, delete: if request.auth != null
                            && get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                               == request.auth.uid;
        allow update: if false;
      }
    }
    // Anyone cards are available to the same exact-code visitors who can see
    // a generated room. Mutual cards require reciprocal Circle choices and no
    // block in either direction. No client can enumerate, create, or alter a
    // profile/edge/block document; Functions are the only write boundary.
    match /roomOwners/{code} {
      // The only raw Firebase uid for a room is never visitor-readable. It is
      // created atomically with the v6 room and consulted only by Rules/Admin.
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if request.auth != null
                  && request.query.limit != null
                  && request.query.limit <= 100
                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'ownerKey', 'updatedAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.ownerKey == ownerKeyFor(request.auth.uid)
                    && existsAfter(/databases/$(database)/documents/rooms/$(code));
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.ownerKey == ownerKeyFor(request.auth.uid);
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && !existsAfter(/databases/$(database)/documents/rooms/$(code));
    }
    match /publicSpaceProfiles/{code} {
      allow get: if validSpaceProfile(resource.data)
                 && profileMatchesLiveRoom(code, resource.data);
      allow list, create, update, delete: if false;
    }
    match /mutualSpaceProfiles/{code} {
      allow get: if validSpaceProfile(resource.data)
                 && profileMatchesLiveRoom(code, resource.data)
                 && request.auth != null
                 && (ownerKeyFor(request.auth.uid) == resource.data.ownerKey
                   || reciprocalCircle(resource.data.ownerKey));
      allow list, create, update, delete: if false;
    }
    match /circleRelationships/{ownerKey}/outgoing/{otherOwnerKey} {
      allow read, write: if false;
    }
    match /spaceBlocks/{ownerKey}/blocked/{otherOwnerKey} {
      allow read, write: if false;
    }
    match /roomDeletionLocks/{code} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/rooms/$(code))
                    && get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                       == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/rooms/$(code))
                    && get(/databases/$(database)/documents/roomOwners/$(code)).data.uid
                       == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && !existsAfter(/databases/$(database)/documents/rooms/$(code));
      allow get, list: if false;
    }
    // A small, authenticated directory of rooms whose owners explicitly opted
    // in. The record has no uid, code field, account/profile copy, activity,
    // journal, quests, streak, or photos. Its document id is only used by the
    // client after a card tap to open the existing exact-code visitor flow.
    match /discoverableSpaces/{code} {
      // The owner may read an expired strict projection only to preserve its
      // moderated name while renewing the lease. Everyone else loses exact
      // access at expiry along with directory visibility.
      allow get: if request.auth != null
                 && validDiscoverableSpaceShape(code, resource.data)
                 && discoverableSpaceHasLiveAnchor(code, resource.data)
                 && (
                   resource.data.expiresAt > request.time
                   || ownsRoom(code)
                 );
      // Collection-query rules must be provable from the query itself. The
      // strict projection predicate remains on every client write and exact
      // get; list access is instead authenticated and tightly bounded. Invalid
      // Admin-written records are also rejected by the client parser.
      allow list: if request.auth != null
                   && request.query.limit != null
                   && request.query.limit > 0
                   && request.query.limit <= 12
                   && resource.data.expiresAt > request.time;
      allow create: if ownsRoom(code)
                    && !serviceIdentityDeletionStarted(request.auth.uid)
                    && !exists(
                      /databases/$(database)/documents/roomDeletionLocks/$(code)
                    )
                    && validDiscoverableSpace(code)
                    && request.resource.data.publicName == '';
      allow update: if ownsRoom(code)
                    && !serviceIdentityDeletionStarted(request.auth.uid)
                    && !exists(
                      /databases/$(database)/documents/roomDeletionLocks/$(code)
                    )
                    && validDiscoverableSpace(code)
                    && resource.data.ownerKey == request.resource.data.ownerKey
                    && (
                      (
                        resource.data.keys().hasAny(['publicName'])
                        && request.resource.data.publicName == resource.data.publicName
                      )
                      || (
                        resource.data.v == 1
                        && !resource.data.keys().hasAny(['publicName'])
                        && request.resource.data.publicName == ''
                      )
                    );
      // Normal opt-out happens while the room exists. The second branch lets
      // the account-deletion batch remove the directory, room, and lock in one
      // fenced commit after the deletion tombstone has started.
      allow delete: if ownsRoom(code)
                    && (
                      !discoverableSpaceHasLiveAnchor(code, resource.data)
                      ||
                      normalRoomRemovalAllowed(code)
                      || fencedRoomRemovalAllowed(code)
                    );
    }
    // Admin-only moderation internals. They are intentionally unavailable to
    // every client, including the reporter and the room owner.
    match /discoveryNameChanges/{uid} {
      allow read, write: if false;
    }
    match /discoveryReports/{code}/{document=**} {
      allow read, write: if false;
    }
    match /serviceIdentityDeletionTombstones/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
