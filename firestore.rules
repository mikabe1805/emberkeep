rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validBuildTitle(title) {
      return title.matches(
        '^(STRONG |MIGHTY |TITAN |VITAL |RADIANT |UNDIMMED |ASTUTE |SAGE |LUMINARY |SKILLED |EXPERT |MASTER |BELOVED |MAGNETIC |BEACON |HOMEY |WELCOMING |SANCTUARY )?(BLANK SLATE|LIONHEART|WARRIOR SCHOLAR|SILENT HAMMER|GENTLE GIANT|HOMESTEADER|CLEAR SPRING|STEADY HAND|STEADY FLAME|SUNSHINE SOUL|EVERGREEN|DEEP CURRENT|STORYTELLER|QUIET MASTER|PRESENT HEART|UNSHAKEABLE|OPEN HOUSE|OPEN HEARTH|BRAWLER|WELLSPRING|SCHOLAR|MAKER|FRIEND|KEEPER)$'
      );
    }

    function validPresence(d) {
      return d.keys().hasAll([
          'memories', 'weather', 'todayLit', 'focusKind', 'focusUntil'
        ])
        && d.memories is int && d.memories >= 0 && d.memories <= 9999
        && d.weather in ['unknown', 'low', 'steady', 'bright']
        && d.todayLit is bool
        && d.focusKind in ['none', 'study', 'making', 'reset', 'quiet']
        && d.focusUntil is int
        && d.focusUntil >= 0 && d.focusUntil <= 9999999999999;
    }

    function validSharedProfile(d) {
      return d.keys().hasAll([
          'profileVisible', 'displayName', 'about', 'featuredGoals'
        ])
        && d.profileVisible is bool
        && d.displayName is string && d.displayName.size() <= 40
        && d.about is string && d.about.size() <= 180
        && d.featuredGoals is list && d.featuredGoals.size() <= 3
        && (d.featuredGoals.size() < 1
          || (d.featuredGoals[0] is string && d.featuredGoals[0].size() <= 100))
        && (d.featuredGoals.size() < 2
          || (d.featuredGoals[1] is string && d.featuredGoals[1].size() <= 100))
        && (d.featuredGoals.size() < 3
          || (d.featuredGoals[2] is string && d.featuredGoals[2].size() <= 100))
        && (d.profileVisible
          || (d.displayName == '' && d.about == '' && d.featuredGoals.size() == 0));
    }

    function validPinnedMoment(moment) {
      return moment is map
        && moment.keys().hasOnly(['text', 'at'])
        && moment.text is string && moment.text.size() > 0
        && moment.text.size() <= 240
        && moment.at is int && moment.at >= 0 && moment.at <= 9999999999999;
    }

    function validSharedCards(d) {
      return d.keys().hasAll(['cardOrder', 'pinnedMoments', 'season'])
        && d.cardOrder is list && d.cardOrder.size() <= 4
        && d.cardOrder.hasOnly([
          'about', 'rightNow', 'pinnedMoments', 'thisSeason'
        ])
        && d.pinnedMoments is list && d.pinnedMoments.size() <= 4
        && (d.pinnedMoments.size() < 1 || validPinnedMoment(d.pinnedMoments[0]))
        && (d.pinnedMoments.size() < 2 || validPinnedMoment(d.pinnedMoments[1]))
        && (d.pinnedMoments.size() < 3 || validPinnedMoment(d.pinnedMoments[2]))
        && (d.pinnedMoments.size() < 4 || validPinnedMoment(d.pinnedMoments[3]))
        && d.season is string && d.season.size() <= 180
        && (d.cardOrder.hasAny(['about']) || d.about == '')
        && (d.cardOrder.hasAny(['rightNow']) || d.featuredGoals.size() == 0)
        && (d.cardOrder.hasAny(['pinnedMoments']) || d.pinnedMoments.size() == 0)
        && (d.cardOrder.hasAny(['thisSeason']) || d.season == '')
        && (d.profileVisible
          || (d.cardOrder.size() == 0
            && d.pinnedMoments.size() == 0
            && d.season == ''));
    }

    function validSharedPhotoPath(path, uid, code, slot) {
      let parts = path.split('/');
      return path == ''
        // Legacy pre-release objects remain valid until their next edit.
        || path == 'shared_rooms/' + uid + '/' + code + '/' + slot
        || (parts.size() == 5
          && parts[0] == 'shared_rooms'
          && parts[1] == uid
          && parts[2] == code
          && parts[3] == slot
          && parts[4].matches('^[A-Za-z0-9_-]{22}$'));
    }

    function validSharedPhotos(d, code) {
      return d.keys().hasAll(['profilePhotoPath', 'seasonPhotoPath'])
        && d.profilePhotoPath is string && d.profilePhotoPath.size() <= 192
        && d.seasonPhotoPath is string && d.seasonPhotoPath.size() <= 192
        && validSharedPhotoPath(d.profilePhotoPath, d.uid, code, 'profile')
        && validSharedPhotoPath(d.seasonPhotoPath, d.uid, code, 'season')
        && (d.profileVisible
          || (d.profilePhotoPath == '' && d.seasonPhotoPath == ''))
        && (d.cardOrder.hasAny(['thisSeason']) || d.seasonPhotoPath == '');
    }

    function validRoom(code) {
      let d = request.resource.data;
      return code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && d.keys().hasOnly([
          'uid', 'name', 'title', 'level', 'furniture', 'wall', 'floor',
          'skin', 'window', 'awake', 'memories', 'weather', 'todayLit',
          'focusKind', 'focusUntil', 'profileVisible', 'displayName', 'about',
          'featuredGoals', 'cardOrder', 'pinnedMoments', 'season', 'v',
          'profilePhotoPath', 'seasonPhotoPath',
          'updatedAt'
        ])
        && d.uid == request.auth.uid
        && d.name == 'Fellow keeper'
        && d.title is string && validBuildTitle(d.title)
        && d.level is int && d.level >= 1 && d.level <= 9999
        && d.furniture is list && d.furniture.size() <= 12
        && d.furniture.hasOnly([
          'rug', 'cushion', 'plant', 'candles', 'lamp', 'garland', 'shelf',
          'picture', 'chair', 'pet', 'hearth'
        ])
        && d.wall in [
          'wall_conservatory', 'wall_archive',
          'wall_walnut', 'wall_plum', 'wall_sage', 'wall_clay', 'wall_amber',
          'wall_indigo', 'wall_berry'
        ]
        && d.floor in [
          'floor_oak', 'floor_ash', 'floor_walnut', 'floor_terra',
          'floor_maple', 'floor_cherry'
        ]
        && d.skin in [
          'ember_amber', 'rose_quartz', 'mint_glass', 'periwinkle', 'lilac',
          'sunstone', 'sea_glass', 'moon_pearl', 'slate', 'gilded',
          'found_ember', 'found_moss', 'found_bloom', 'found_honey',
          'found_candle', 'found_aurora', 'found_midnight',
          'found_periwinkle', 'found_plum', 'found_storm', 'found_rosewood',
          'found_founder', 'found_weeklong', 'found_eternal',
          'found_spotless', 'found_renaissance', 'found_marathoner'
        ]
        && d.window in ['moon', 'city', 'forest', 'mountains', 'rain', 'dawn', 'aurora']
        && d.awake is bool
        && (
          (d.v == 1 && !d.keys().hasAny([
            'memories', 'weather', 'todayLit', 'focusKind', 'focusUntil',
            'profileVisible', 'displayName', 'about', 'featuredGoals',
            'cardOrder', 'pinnedMoments', 'season',
            'profilePhotoPath', 'seasonPhotoPath'
          ]))
          ||
          (d.v == 2
            && validPresence(d)
            && !d.keys().hasAny([
              'profileVisible', 'displayName', 'about', 'featuredGoals',
              'cardOrder', 'pinnedMoments', 'season',
              'profilePhotoPath', 'seasonPhotoPath'
            ])
          )
          ||
          (d.v == 3
            && validPresence(d)
            && validSharedProfile(d)
            && !d.keys().hasAny([
              'cardOrder', 'pinnedMoments', 'season',
              'profilePhotoPath', 'seasonPhotoPath'
            ])
          )
          ||
          (d.v == 4
            && validPresence(d)
            && validSharedProfile(d)
            && validSharedCards(d)
            && !d.keys().hasAny(['profilePhotoPath', 'seasonPhotoPath'])
          )
          ||
          (d.v == 5
            && validPresence(d)
            && validSharedProfile(d)
            && validSharedCards(d)
            && validSharedPhotos(d, code)
            // The first store release shares generated room/presence only.
            // User-authored profiles remain dormant until UGC moderation exists.
            && d.profileVisible == false
          )
        )
        && d.updatedAt == request.time;
    }

    // Each anonymous user may touch exactly one document: their own save.
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared "spaces" (round-52, social): a public, read-only-to-others room
    // card keyed by a short bearer code. The v1 store service accepts only v5
    // generated appearance/presence documents with every user-authored profile
    // and photo field empty. Older schema validation remains solely to document
    // migrations; it is not accepted at the write boundary. Only the owner may
    // create, replace, or delete a room document.
    match /rooms/{code} {
      // A code is the bearer key. Single-room reads work without forcing a
      // visitor to enable cloud backup. The only list shape is a bounded query
      // for the signed-in owner's own uid, used to prove anonymous deletion.
      // Legacy pre-release profile documents remain stored for their owners,
      // but code bearers cannot read them. Only the generated-only v5 shape is
      // visible in the first store release.
      allow get: if resource.data.v == 5
                 && resource.data.profileVisible == false;
      allow list: if request.auth != null
                  && resource.data.uid == request.auth.uid
                  && request.query.limit != null
                  && request.query.limit <= 100;
      allow create: if request.auth != null
                    && request.resource.data.v == 5
                    && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                    && validRoom(code);
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.v == 5
                    && request.resource.data.v >= resource.data.v
                    && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                    && validRoom(code);
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && (
                      !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      || (
                        get(/databases/$(database)/documents/roomDeletionLocks/$(code)).data.uid
                          == request.auth.uid
                        && !existsAfter(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      )
                    );

      // Text-free encouragement only. A sender has one pending document,
      // keyed by their uid; only the room owner can see or collect it. There
      // is no chat body, task data, profile body, or public sender list.
      match /sparks/{senderId} {
        // Mirrors circleAdds: you cannot spark your own room, so the support
        // inbox can never be self-inflated through the raw API.
        allow create: if request.auth != null
                      && senderId == request.auth.uid
                      && exists(/databases/$(database)/documents/rooms/$(code))
                      && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      && get(/databases/$(database)/documents/rooms/$(code)).data.uid
                         != request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'sender', 'kind', 'sentAt'
                      ])
                      && request.resource.data.sender == request.auth.uid
                      && request.resource.data.kind in [
                        'kindle', 'steady', 'cheer'
                      ]
                      && request.resource.data.sentAt == request.time;
        allow read, delete: if request.auth != null
                            && get(/databases/$(database)/documents/rooms/$(code)).data.uid
                               == request.auth.uid;
        allow update: if false;
      }

      // A generic, text-free receipt when somebody saves this room to Circle.
      // It is private to the room owner and deliberately carries no profile.
      match /circleAdds/{senderId} {
        allow create: if request.auth != null
                      && senderId == request.auth.uid
                      && exists(/databases/$(database)/documents/rooms/$(code))
                      && !exists(/databases/$(database)/documents/roomDeletionLocks/$(code))
                      && get(/databases/$(database)/documents/rooms/$(code)).data.uid
                         != request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'sender', 'kind', 'sentAt'
                      ])
                      && request.resource.data.sender == request.auth.uid
                      && request.resource.data.kind == 'circle_added'
                      && request.resource.data.sentAt == request.time;
        allow read, delete: if request.auth != null
                            && get(/databases/$(database)/documents/rooms/$(code)).data.uid
                               == request.auth.uid;
        allow update: if false;
      }
    }
    match /roomDeletionLocks/{code} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/rooms/$(code))
                    && get(/databases/$(database)/documents/rooms/$(code)).data.uid
                       == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/rooms/$(code))
                    && get(/databases/$(database)/documents/rooms/$(code)).data.uid
                       == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && !existsAfter(/databases/$(database)/documents/rooms/$(code));
      allow get, list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
