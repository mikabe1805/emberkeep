rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validBuildTitle(title) {
      return title.matches(
        '^(STRONG |MIGHTY |TITAN |VITAL |RADIANT |UNDIMMED |ASTUTE |SAGE |LUMINARY |SKILLED |EXPERT |MASTER |BELOVED |MAGNETIC |BEACON |HOMEY |WELCOMING |SANCTUARY )?(BLANK SLATE|LIONHEART|WARRIOR SCHOLAR|SILENT HAMMER|GENTLE GIANT|HOMESTEADER|CLEAR SPRING|STEADY FLAME|SUNSHINE SOUL|EVERGREEN|DEEP CURRENT|STORYTELLER|QUIET MASTER|PRESENT HEART|UNSHAKEABLE|OPEN HEARTH|BRAWLER|WELLSPRING|SCHOLAR|MAKER|FRIEND|KEEPER)$'
      );
    }

    function validRoom(code) {
      let d = request.resource.data;
      return code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && d.keys().hasOnly([
          'uid', 'name', 'title', 'level', 'furniture', 'wall', 'floor',
          'skin', 'window', 'awake', 'v', 'updatedAt'
        ])
        && d.uid == request.auth.uid
        && d.name == 'Fellow keeper'
        && d.title is string && validBuildTitle(d.title)
        && d.level is int && d.level >= 1 && d.level <= 9999
        && d.furniture is list && d.furniture.size() <= 12
        && d.furniture.hasOnly([
          'rug', 'cushion', 'plant', 'candles', 'lamp', 'garland', 'shelf',
          'picture', 'chair', 'pet', 'hearth'
        ])
        && d.wall in [
          'wall_walnut', 'wall_plum', 'wall_sage', 'wall_clay', 'wall_amber',
          'wall_indigo', 'wall_berry'
        ]
        && d.floor in [
          'floor_oak', 'floor_ash', 'floor_walnut', 'floor_terra',
          'floor_maple', 'floor_cherry'
        ]
        && d.skin in [
          'ember_amber', 'rose_quartz', 'mint_glass', 'periwinkle', 'lilac',
          'sunstone', 'sea_glass', 'moon_pearl', 'slate', 'gilded'
        ]
        && d.window in ['moon', 'city', 'forest', 'mountains', 'rain', 'dawn', 'aurora']
        && d.awake is bool
        && d.v == 1
        && d.updatedAt == request.time;
    }

    // Each anonymous user may touch exactly one document: their own save.
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared "spaces" (round-52, social): a public, read-only-to-others room
    // card keyed by a short share code. Only preset appearance/progression —
    // never free-form text, quests, notes or email. Signed-in visitors may READ to
    // visit; you may only create/replace/delete a doc stamped with YOUR uid,
    // so no one can overwrite someone else's space.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && validRoom(code);
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && validRoom(code);
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
