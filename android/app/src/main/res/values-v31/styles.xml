<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/emberkeep_launch</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- postSplashScreenTheme is an androidx-splashscreen attr, not a
             framework one; Flutter already switches to NormalTheme via the
             manifest meta-data, so nothing is lost by omitting it. -->
        <item name="android:statusBarColor">@color/emberkeep_launch</item>
        <item name="android:navigationBarColor">@color/emberkeep_launch</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
